<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Köprü"
            android:textSize="34sp"
            android:textStyle="bold"
            android:textColor="#1B1F24" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Telefonun mobil verisini USB ile Mac'e paylaşır"
            android:textColor="#5B6470"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="#EEF2F6"
            android:padding="16dp"
            android:text="Durduruldu"
            android:textColor="#1B1F24"
            android:textSize="16sp" />

        <Button
            android:id="@+id/toggle"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:text="Başlat"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp"
            android:textColor="#1B1F24"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Ayarlar"
            android:textStyle="bold"
            android:textColor="#1B1F24"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/forceCellular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Her zaman mobil veriyi kullan (Wi-Fi açık olsa bile)" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Port"
                android:textColor="#1B1F24"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/port"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:inputType="number"
                android:maxLength="5" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="İlk kurulum: Ayarlar › Telefon hakkında › Yapı numarasına 7 kez dokunun, ardından Geliştirici seçeneklerinden &quot;USB hata ayıklama&quot;yı açın."
            android:textColor="#5B6470"
            android:textSize="14sp" />

        <Button
            android:id="@+id/devOptions"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Geliştirici seçeneklerini aç" />
    </LinearLayout>
</ScrollView>
